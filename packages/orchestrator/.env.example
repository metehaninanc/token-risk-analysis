# Copy to `.env` and fill in. `.env` is git-ignored — never commit secrets.
# Base URLs have working defaults; you normally only set the keys and RPC URL.

# ── Data-collection sources ──────────────────────────────────────
# (1) GoPlus Token Security API — public, no key required.
GOPLUS_BASE_URL=https://api.gopluslabs.io/api/v1

# (2) honeypot.is — public, no key required.
HONEYPOT_IS_BASE_URL=https://api.honeypot.is/v2

# (3) SafeAnalyzer (dexanalyzer.io) — POST /eth, apiKey header is MANDATORY.
SAFEANALYZER_API_KEY=
SAFEANALYZER_BASE_URL=https://api1.dexanalyzer.io

# (4) DexScreener — public, no key required.
DEXSCREENER_BASE_URL=https://api.dexscreener.com/latest

# Etherscan — used ONLY to fetch verified source for the code-level checker,
# NOT as an independent signal source.
ETHERSCAN_API_KEY=
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api

# ── LLM (code-level checker + conversational layer) ──────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── On-chain (LP-lock reader, ethers v6) ─────────────────────────
ETH_RPC_URL=

# ── Reproducibility ──────────────────────────────────────────────
# Where raw collector responses are archived as {address}/{source}.json
ARCHIVE_DIR=./data/raw
